{
  "info": {
    "_postman_id": "feature-comments-collection",
    "name": "feature",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Подготовка данных",
      "item": [
        {
          "name": "Подготовка тестовых данных",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const main = async () => {\n    const api = new API(pm);\n    const rnd = new RandomUtils();\n    try {\n        const user1 = await api.addUser(rnd.getUser());\n        const user2 = await api.addUser(rnd.getUser());\n        const category = await api.addCategory(rnd.getCategory());\n        let publishedEvent = await api.addEvent(user1.id, rnd.getEvent(category.id));\n        publishedEvent = await api.publishEvent(publishedEvent.id);\n        const unpublishedEvent = await api.addEvent(user1.id, rnd.getEvent(category.id));\n        pm.collectionVariables.set('userId1', user1.id);\n        pm.collectionVariables.set('userId2', user2.id);\n        pm.collectionVariables.set('publishedEventId', publishedEvent.id);\n        pm.collectionVariables.set('unpublishedEventId', unpublishedEvent.id);\n    } catch(err) {\n        console.error('Ошибка при подготовке тестовых данных.', err);\n    }\n};\nconst interval = setInterval(() => {}, 1000);\nsetTimeout(async () => {\n    try { await main(); } catch (e) { console.error(e); }\n    finally { clearInterval(interval); }\n}, 100);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Подготовка данных выполнена\", function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/categories?from=0&size=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "1"
                }
              ]
            }
          }
        }
      ]
    },
